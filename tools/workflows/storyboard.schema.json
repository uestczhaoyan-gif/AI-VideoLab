{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "scenes"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "scenes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "headline",
          "caption",
          "shapes"
        ],
        "properties": {
          "headline": {
            "type": "string",
            "minLength": 1,
            "maxLength": 28
          },
          "caption": {
            "type": "string",
            "minLength": 1,
            "maxLength": 56
          },
          "shapes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "color",
                "points"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "line",
                    "loop",
                    "dot",
                    "box"
                  ]
                },
                "color": {
                  "enum": [
                    "primary",
                    "accent",
                    "muted",
                    "ink"
                  ]
                },
                "points": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 20,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "x",
                      "y"
                    ],
                    "properties": {
                      "x": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                      },
                      "y": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
