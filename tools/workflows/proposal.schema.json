{
  "type": "object",
  "additionalProperties": false,
  "required": ["workflow_id", "style_id", "duration_seconds", "aspect_ratio", "rationale", "assumptions", "question", "missing_inputs", "voice_mode", "segments", "references"],
  "properties": {
    "workflow_id": { "type": "string", "minLength": 1 },
    "style_id": { "type": "string", "minLength": 1 },
    "duration_seconds": { "type": "number", "minimum": 3, "maximum": 3600 },
    "aspect_ratio": { "enum": ["16:9", "9:16", "1:1", "3:4"] },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 500 },
    "assumptions": { "type": "string", "maxLength": 500 },
    "question": { "type": "string", "maxLength": 200 },
    "missing_inputs": {
      "type": "array", "maxItems": 4,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "voice_mode": { "enum": ["narration", "captions"] },
    "segments": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["seconds", "visual", "text"],
        "properties": {
          "seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 3600 },
          "visual": { "type": "string", "minLength": 1, "maxLength": 500 },
          "text": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "references": {
      "type": "array", "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "used_for"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "used_for": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    }
  }
}
