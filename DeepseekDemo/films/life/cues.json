  "captions": [
    {
      "text": "一开始，只是一团卷曲",
      "t0": 1.6,
      "t1": 5.66,
      "x": 140,
      "y": 986,
      "fade": 0.45,
      "size": 30,
      "family": "NotoSerifSC",
      "weight": 300
    },
    {
      "text": "风把线拉高——那是童年",
      "t0": 6.26,
      "t1": 12.48,
      "x": 140,
      "y": 986,
      "fade": 0.45,
      "size": 30,
      "family": "NotoSerifSC",
      "weight": 300
    },
    {
      "text": "书要一页一页读",
      "t0": 13.08,
      "t1": 16.35,
      "x": 140,
      "y": 986,
      "fade": 0.45,
      "size": 30,
      "family": "NotoSerifSC",
      "weight": 300
    },
    {
      "text": "台阶一步一步上",
      "t0": 16.95,
      "t1": 20.56,
      "x": 140,
      "y": 986,
      "fade": 0.45,
      "size": 30,
      "family": "NotoSerifSC",
      "weight": 300
    },
    {
      "text": "门口有过光",
      "t0": 21.16,
      "t1": 23.07,
      "x": 140,
      "y": 986,
      "fade": 0.45,
      "size": 30,
      "family": "NotoSerifSC",
      "weight": 300
    },
    {
      "text": "山顶插过一面旗",
      "t0": 23.67,
      "t1": 28.18,
      "x": 140,
      "y": 986,
      "fade": 0.45,
      "size": 30,
      "family": "NotoSerifSC",
      "weight": 300
    },
    {
      "text": "也摔过，摔出一道裂缝",
      "t0": 28.78,
      "t1": 31.71,
      "x": 140,
      "y": 986,
      "fade": 0.45,
      "size": 30,
      "family": "NotoSerifSC",
      "weight": 300
    },
    {
      "text": "心打成结的那些年",
      "t0": 32.31,
      "t1": 46.38,
      "x": 140,
      "y": 986,
      "fade": 0.45,
      "size": 30,
      "family": "NotoSerifSC",
      "weight": 300
    },
    {
      "text": "后来，线自己松开了",
      "t0": 46.98,
      "t1": 52.29,
      "x": 140,
      "y": 986,
      "fade": 0.45,
      "size": 30,
      "family": "NotoSerifSC",
      "weight": 300
    },
    {
      "text": "剩下的时间，只做喜欢的事",
      "t0": 52.89,
      "t1": 65.2,
      "x": 140,
      "y": 986,
      "fade": 0.45,
      "size": 30,
      "family": "NotoSerifSC",
      "weight": 300
    },
    {
      "text": "最后，画成一个圆",
      "t0": 65.8,
      "t1": 81.4,
      "x": 140,
      "y": 986,
      "fade": 0.45,
      "size": 30,
